# ==============================================================================
# PUMEN AGENT - ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` (e.g., cp .env.sample .env)
# 2. Fill in the required values below.
# 3. DO NOT commit your `.env` file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Settings
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. AI Provider Credentials
# ------------------------------------------------------------------------------
# Gemini API Key (Required for core LLM functionalities)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. Browser Automation Settings
# ------------------------------------------------------------------------------
# Absolute path to Chrome/Chromium executable (Optional but recommended)
# Windows Example: "C:\Program Files\Google\Chrome\Application\chrome.exe"
# Linux Example: "/usr/bin/google-chrome"
CHROME_EXECUTABLE_PATH=""

# ------------------------------------------------------------------------------
# 4. Messaging Channels (Optional Integrations)
# ------------------------------------------------------------------------------
# Telegram Bot Token (Get from BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Discord Bot Token (Get from Discord Developer Portal)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
